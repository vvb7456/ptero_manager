# Erocraft Manager 环境变量示例
#
# 使用方式：
# 1. 复制本文件为 .env。
# 2. 按实际部署环境修改所有密码、密钥、域名和路径。
# 3. 生产环境不要复用示例密钥。
#
# 布尔值支持：
# true/false、1/0、yes/no、on/off。


# =============================================================================
# 应用基础配置
# =============================================================================

# 应用名称，仅用于后端元信息或默认展示。
APP_NAME=Erocraft Manager

# 应用版本号。
APP_VERSION=2.0.0

# 默认时区。国内部署通常使用 Asia/Shanghai。
TIMEZONE=Asia/Shanghai

# 日志级别。常用值：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# 是否启用 OpenAPI / Swagger 文档。
# 生产环境建议保持 false。
ENABLE_API_DOCS=false


# =============================================================================
# 安全与加密
# =============================================================================

# 必填。后端主密钥，至少 32 字符。
# 可用以下命令生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_unique_64_hex_character_value

# 可选。运行时配置加密密钥。
# 不配置时会复用 SECRET_KEY。
SETTINGS_ENCRYPTION_KEY=

# Pterodactyl 面板 APP_KEY。
# PANEL_APP_KEY 是 Manager 推荐字段；APP_KEY 保留用于兼容已有 Pterodactyl 配置。
PANEL_APP_KEY=
APP_KEY=


# =============================================================================
# HTTP Session / Cookie
# =============================================================================

# 后端会话 Cookie 名称。
SESSION_COOKIE_NAME=erocraft_manager_session

# 会话有效期，单位：秒。默认 1209600 秒，即 14 天。
SESSION_MAX_AGE=1209600

# 是否只允许 HTTPS 传输 Cookie。
# HTTPS 生产环境建议设置为 true。
SESSION_COOKIE_SECURE=false

# Cookie SameSite 策略。常用值：lax、strict、none。
SESSION_SAME_SITE=lax


# =============================================================================
# 数据库
# =============================================================================

# MySQL / MariaDB 连接配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=panel
DB_PASSWORD=replace_with_database_password
DB_NAME=panel

# 可选：完整 SQLAlchemy 同步连接 URL。
# 配置后会优先用于迁移和同步数据库访问。
DATABASE_URL=

# 可选：完整 SQLAlchemy 异步连接 URL。
# 配置后会优先用于后端异步运行时数据库访问。
ASYNC_DATABASE_URL=

# 是否让异步数据库引擎使用 NullPool。
# 测试或特殊部署环境可开启。
ASYNC_DATABASE_USE_NULL_POOL=false


# =============================================================================
# manager.sh 进程管理脚本
# =============================================================================

# ASGI 应用入口。
MANAGER_WEB_APP=app.main:app

# Web 服务监听地址与端口。
MANAGER_WEB_HOST=0.0.0.0
MANAGER_WEB_PORT=5001

# Uvicorn worker 数量。
MANAGER_WEB_WORKERS=1

# manager.sh 用于健康检查的 URL。
MANAGER_WEB_HEALTH_URL=http://127.0.0.1:5001/api/version

# 后台任务入口模块。
MANAGER_JOBS_MODULE=app.jobs.main


# =============================================================================
# 品牌与公开站点配置
# =============================================================================

# 前端品牌名称。
BRAND_NAME=Erocraft Manager

# 前端系统名称。为空时使用默认名称。
UI_SYSTEM_NAME=

# 对外站点 URL，例如 https://panel.example.com。
SITE_URL=

# 前端横幅图片 URL。
UI_BANNER_URL=

# ICP 备案号。
UI_ICP_RECORD=

# 是否允许公开注册。
ALLOW_PUBLIC_REGISTRATION=true


# =============================================================================
# 邮件 / SMTP
# =============================================================================

# SMTP 服务器地址。
SMTP_HOST=

# SMTP 端口。
SMTP_PORT=587

# 是否使用 SSL 连接。
SMTP_USE_SSL=true

# SMTP 密码或应用专用密码。
SMTP_PASSWORD=

# 发件人邮箱。
SENDER_EMAIL=

# 批量邮件发送间隔，单位：秒。
EMAIL_SEND_DELAY=2


# =============================================================================
# 默认服务器创建参数
# =============================================================================

# 默认 Nest / Egg / Node ID。
# 注意：这些字段对应 Pterodactyl 既有数据模型，必须与面板数据保持一致。
DEFAULT_NEST_ID=1
DEFAULT_EGG_ID=1
DEFAULT_NODE_ID=1

# 默认 Docker 镜像。
DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_17

# 默认资源限制。
DEFAULT_CPU=100
DEFAULT_MEMORY=1024
DEFAULT_DISK=5120
DEFAULT_DATABASES=0
DEFAULT_BACKUPS=0
DEFAULT_ALLOCATIONS=1


# =============================================================================
# 自动化任务
# =============================================================================

# 每日自动化任务执行时间。
AUTOMATION_RUN_HOUR=2
AUTOMATION_RUN_MINUTE=0

# 是否启用自动暂停。
AUTOMATION_SUSPEND_ENABLED=false

# 是否启用自动删除。
AUTOMATION_DELETE_ENABLED=false

# 自动删除前保留天数。
AUTOMATION_DELETE_DAYS=14

# 是否启用自动邮件任务。
AUTOMATION_EMAIL_ENABLED=false

# 自动邮件任务执行时间。
AUTOMATION_EMAIL_RUN_HOUR=10
AUTOMATION_EMAIL_RUN_MINUTE=0


# =============================================================================
# 监控与告警
# =============================================================================

# 监控数据保留天数。
MONITOR_RETENTION_DAYS=30

# 监控采集间隔，单位：秒。
MONITOR_INTERVAL_SEC=60

# 默认告警接收管理员 ID，多个 ID 用英文逗号分隔。
ALERT_DEFAULT_RECIPIENTS=


# =============================================================================
# 证书管理
# =============================================================================

# 必填。acme.sh 安装目录。
# 后端会扫描该目录下的证书，并读取 acme.sh 管理的证书元信息。
# 未配置或为空时，后端会拒绝启动。
CERT_ACME_SH_HOME=/root/.acme.sh

# 必填。acme.sh 可执行文件路径。
# 后端执行强制续期等动作时会调用该文件。
# 未配置或为空时，后端会拒绝启动。
CERT_ACME_SH_BIN=/root/.acme.sh/acme.sh

# 可选。用于 acme.sh reloadcmd / deploy hook 回调 Manager 的 token。
CERT_WEBHOOK_TOKEN=

# 是否启用证书告警邮件。
CERT_ALERT_EMAIL_ENABLED=true

# 证书告警接收管理员 ID，多个 ID 用英文逗号分隔。
CERT_ALERT_EMAIL_ADMIN_IDS=
